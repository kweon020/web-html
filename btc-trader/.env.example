# 이 파일을 .env로 복사해서 채우세요. .env는 절대 커밋하지 마세요.
#
#   cp .env.example .env
#
# 백테스트와 페이퍼 트레이딩만 할 거면 이 키들은 필요 없습니다.
# 업비트 공개 시세 API는 인증 없이 쓸 수 있습니다.
#
# 나중에 실거래를 붙일 때만 채우세요. 그때도:
#   - 출금 권한은 절대 켜지 마세요 (조회 + 주문만)
#   - IP 주소 등록(화이트리스트)을 반드시 하세요
#   - 키가 유출된 것 같으면 업비트에서 즉시 삭제하세요

UPBIT_ACCESS_KEY=
UPBIT_SECRET_KEY=
